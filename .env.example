# Database configuration (PostgreSQL + PGVector)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rag_multimodal
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Multimodal CLIP Model
EMBEDDING_MODEL_NAME=clip-ViT-B-32
EMBEDDING_DIM=512

# Ollama local configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# LLM Provider: 'ollama', 'local', 'groq', 'openai', or 'auto'
LLM_PROVIDER=ollama

# Optional Cloud API keys (if not using local Ollama)
# GROQ_API_KEY=
# OPENAI_API_KEY=
